{
  "name": "mc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-convex-codegen.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:codegen": "node scripts/check-convex-codegen.mjs",
    "check:ci": "pnpm check:codegen && pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test",
    "test:contracts:ci": "cd contracts && FOUNDRY_PROFILE=ci forge test",
    "install:forge-deps": "bash scripts/install-forge-deps.sh",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "audit:all": "pnpm audit --audit-level=high",
    "audit:all:gated": "node scripts/audit-all-gated.mjs",
    "prepare": "husky",
    "smoke:crash-lifecycle": "node scripts/smoke-crash-lifecycle.cjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@margin-call/shared": "workspace:*",
    "@privy-io/react-auth": "^3.37.0",
    "@privy-io/server-auth": "^1.32.5",
    "@sentry/nextjs": "^10.69.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@inco/lightning": "1.0.2",
    "@inco/lightning-js": "1.0.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "convex-test": "^0.0.55",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@safe-global/safe-smart-account": "1.5.0",
      "axios": ">=1.16.0",
      "ws@<8": ">=7.5.11",
      "ws@>=8": ">=8.21.0",
      "form-data": ">=4.0.6",
      "flatted": ">=3.4.2",
      "path-to-regexp@>=8": ">=8.4.0",
      "hono": ">=4.12.25",
      "socket.io-parser": ">=4.2.6",
      "h3": ">=1.15.6",
      "defu": ">=6.1.5",
      "js-cookie": ">=3.0.7",
      "lodash": ">=4.18.0",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "eslint-plugin-react-hooks": "7.0.1"
    }
  }
}
