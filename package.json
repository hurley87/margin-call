{
  "name": "mc",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-convex-codegen.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:codegen": "node scripts/check-convex-codegen.mjs",
    "check:ci": "pnpm check:codegen && pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:contracts": "cd contracts && forge test",
    "test:contracts:ci": "cd contracts && FOUNDRY_PROFILE=ci forge test",
    "test:contracts:fork": "bash scripts/test-base-mainnet-fork.sh",
    "test:contracts:smoke": "bash contracts/script/run-local.sh",
    "test:contracts:smoke:financed": "bash contracts/script/run-financed-local.sh",
    "test:contracts:smoke:executor-transfer": "bash contracts/script/run-executor-transfer-local.sh",
    "contracts:preflight:base": "bash contracts/script/preflight-base-mainnet.sh",
    "contracts:deploy:base:dry": "bash contracts/script/run-deploy-base-dry.sh",
    "contracts:accept:base:dry": "bash contracts/script/run-accept-base-dry.sh",
    "install:forge-deps": "bash scripts/install-forge-deps.sh",
    "optimize:artwork": "node scripts/optimize-artwork.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "audit:all": "pnpm audit --audit-level=high",
    "audit:all:gated": "node scripts/audit-all-gated.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dynamic-labs-sdk/client": "^1.33.4",
    "@dynamic-labs-sdk/evm": "^1.33.4",
    "@dynamic-labs-sdk/react-hooks": "^1.33.4",
    "@margin-call/shared": "workspace:*",
    "@sentry/nextjs": "^10.74.0",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "drawably": "0.4.2",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "convex-test": "^0.0.58",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@safe-global/safe-smart-account": "1.5.0",
      "axios": ">=1.16.0",
      "ws@<8": ">=7.5.11",
      "ws@>=8": ">=8.21.0",
      "form-data": ">=4.0.6",
      "flatted": ">=3.4.2",
      "path-to-regexp@>=8": ">=8.4.0",
      "hono": ">=4.12.25",
      "socket.io-parser": ">=4.2.6",
      "h3": ">=1.15.6",
      "defu": ">=6.1.5",
      "js-cookie": ">=3.0.7",
      "lodash": ">=4.18.0",
      "picomatch@2": "2.3.2",
      "picomatch@4": "4.0.4",
      "eslint-plugin-react-hooks": "7.0.1"
    }
  }
}
