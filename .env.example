# Convex
NEXT_PUBLIC_CONVEX_URL=       # From `npx convex dev` or Convex dashboard (e.g. https://xxx.convex.cloud)
CONVEX_DEPLOYMENT=            # Deployment name (e.g. dev:xxx) — set by `npx convex dev` in .env.local
# Convex dashboard env (actions): BASE_RPC_URL — optional Base JSON-RPC for receipt sync +
# reconciliation; defaults to https://mainnet.base.org when unset.

# Dynamic
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=  # From Dynamic console → Developer → API. Enable external EVM wallets + Base (8453); allowlist localhost:3000 and prod origin; use in-app token storage.

# Dynamic server wallet (agent reference demo). Not required for the website or
# the public agent API. These are not a raw private key — signing material stays
# in Dynamic's backup service.
DYNAMIC_ENVIRONMENT_ID=          # Optional; falls back to NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID
DYNAMIC_API_TOKEN=               # Dynamic console → Developer → API tokens
DYNAMIC_WALLET_PASSWORD=         # Password that encrypts the MPC backup; not a private key
DYNAMIC_AGENT_WALLET_STORE=      # Optional path for wallet metadata (default .dynamic-agent-wallet.json)

# Uniswap Trading API (Dynamic reference stock acquisition only). Not required
# for the public agent API or for agents that already swap (e.g. Bankr).
# https://developers.uniswap.org/docs/trading/swapping-api/start-building/integration-guide
UNISWAP_API_KEY=

# App
NEXT_PUBLIC_APP_URL=         # Base URL for app metadata (e.g. http://localhost:3000)

# Base mainnet RPC (public reads; writes go through the connected wallet)
NEXT_PUBLIC_BASE_RPC_URL=    # Optional; defaults to https://mainnet.base.org

# RPC placeholders for future testnet work
BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=           # For source map uploads
SENTRY_ORG=
SENTRY_PROJECT=
