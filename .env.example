# Convex
NEXT_PUBLIC_CONVEX_URL=       # From `npx convex dev` or Convex dashboard (e.g. https://xxx.convex.cloud)
CONVEX_DEPLOYMENT=            # Deployment name (e.g. dev:xxx) — set by `npx convex dev` in .env.local
CONVEX_DEPLOY_KEY=            # Required by Next.js API routes that call internal Convex functions (createConvexAdminClient). Generate with: `npx convex deployment token create local-dev --save-env`

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=    # Privy app ID; dashboard must enable Email OTP and Embedded Wallets
PRIVY_APP_SECRET=            # Server auth secret; dashboard must enable gas sponsorship for Robinhood Chain testnet

# OpenAI
OPENAI_API_KEY=

# CoinGecko (newswire price data) — free Demo tier works for the onchain endpoints.
# Convex env var: set via `npx convex env set COINGECKO_API_KEY "CG-xxxx"`.
COINGECKO_API_KEY=

# Newswire tweet posting. Leave unset/0 for dry-run (default). Set to 1 to post
# each drop's tweet variant to X — requires the four user-context creds below.
MC_WIRE_TWEETS_LIVE=
# X / Twitter posting (Convex env vars). Posting needs USER-context OAuth 1.0a
# with Read+Write permission — the app-only Bearer token is read-only.
#   Portal → your app → Keys and tokens:
#   - Consumer keys        → TWITTER_CONSUMER_KEY / TWITTER_CONSUMER_SECRET
#   - Access token & secret → TWITTER_ACCESS_TOKEN / TWITTER_ACCESS_TOKEN_SECRET
#     (regenerate the access token AFTER setting app permissions to Read+Write)
# Set via: npx convex env set TWITTER_ACCESS_TOKEN "..."  (etc.)
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Resend transactional email
RESEND_API_KEY=               # Convex env var — required for wipeout emails from admin@margincall.fun

# Coinbase CDP
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=          # Required for CDP SDK wallet signing

# Payments
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS=

# Agent Runtime
NEXT_PUBLIC_APP_URL=         # Base URL for internal API calls (e.g. http://localhost:3000)
CRON_SECRET=                 # Bearer for /api/narrative/generate and /api/agent/scheduler (Vercel Cron)

# RPC — Floor (required; no silent public fallback)
ROBINHOOD_TESTNET_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=
# Legacy deploy scripts only — Floor runtime does not use these
BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Floor (#249) — Robinhood-only (MARGIN_CALL_NETWORK=base-sepolia fails closed)
MARGIN_CALL_NETWORK=robinhood-testnet
NEXT_PUBLIC_MARGIN_CALL_NETWORK=robinhood-testnet
# Public: https://rpc.testnet.chain.robinhood.com
# Alchemy: https://robinhood-testnet.g.alchemy.com/v2/{API_KEY}

# Contracts deploy (MockUSD and later Pack economy contracts)
# Fund the deployer from https://faucet.testnet.chain.robinhood.com
DEPLOYER_PRIVATE_KEY=        # Or: cast wallet private-key --account <name>
# Optional MockUSD constructor / role overrides (defaults: admin = deployer)
MOCKUSD_ADMIN=
MOCKUSD_MINTER=
MOCKUSD_ADDRESS=             # Filled by `pnpm deploy:mockusd`
NEXT_PUBLIC_MOCKUSD_ADDRESS= # Same address for the client
# Optional PackCustody constructor / role overrides (defaults: admin = deployer,
# whitelist = the five approved Stock Tokens in docs/prd-margin-call-token.md)
PACKCUSTODY_ADMIN=
PACKCUSTODY_WHITELIST_ADMIN=
PACKCUSTODY_WHITELIST=           # Comma-separated asset addresses
PACKCUSTODY_ADDRESS=             # Filled by `pnpm deploy:packcustody`
NEXT_PUBLIC_PACKCUSTODY_ADDRESS= # Same address for the client
# Optional AssetRegistry constructor / seed overrides (defaults: admin = deployer,
# seed MockPriceFeeds + addAsset for the five Stock Tokens in
# contracts/deployments/robinhood-testnet.stock-tokens.json)
ASSETREGISTRY_ADMIN=
ASSETREGISTRY_INVENTORY=         # Granted INVENTORY_ROLE when admin == deployer
ASSETREGISTRY_STALE_AFTER=       # Seconds; seeded test feeds default to uint64 max (static fixtures)
ASSETREGISTRY_SEED_FEEDS=        # true/false; default true
ASSETREGISTRY_ADDRESS=             # Filled by `pnpm deploy:asset-registry`
NEXT_PUBLIC_ASSETREGISTRY_ADDRESS= # Same address for the client

# RipEngine (issue #301 / #310)
RIPENGINE_ADMIN=
RIPENGINE_SEED=                    # MockRandomness base seed; default 0xC0FFEE
RIPENGINE_GRANT_ROLE=              # true/false; default true
RIPENGINE_ADDRESS=                 # Filled by `pnpm deploy:rip-engine`
NEXT_PUBLIC_RIPENGINE_ADDRESS=     # Same address for the client

# GameToken (issue #303 / #310)
GAMETOKEN_ADMIN=
GAMETOKEN_TREASURY=                # Defaults to deployer; receives the whole fixed supply
GAMETOKEN_SUPPLY=                  # 18-decimal units; default 1e9 tokens
GAMETOKEN_ADDRESS=                 # Filled by `pnpm deploy:game-token`
NEXT_PUBLIC_GAMETOKEN_ADDRESS=     # Same address for the client

# Distributor (issue #304 / #310 — on-chain Maker Emissions + equal-per-Rip Participation Rewards)
DISTRIBUTOR_ADMIN=
DISTRIBUTOR_GRANT_ROLE=            # true/false; default true
DISTRIBUTOR_FUND=                  # 18-decimal units transferred from the GameToken treasury
DISTRIBUTOR_MAKER_RATE=            # makerRatePerEpoch (tokens per Pack per day)
DISTRIBUTOR_TAKER_POT=             # takerPotPerEpoch (equal-per-Rip daily pot)
DISTRIBUTOR_RIP_ENGINE=            # Optional; binds Distributor.setRipEngine (defaults to RIPENGINE_ADDRESS)
DISTRIBUTOR_WIRE_RIPENGINE=        # true/false; default true when RIPENGINE_ADDRESS is set
DISTRIBUTOR_ADDRESS=               # Filled by `pnpm deploy:distributor`
NEXT_PUBLIC_DISTRIBUTOR_ADDRESS=   # Same address for the client

# Convex env mirrors (pool indexer + Starter Grant — #305). After deploy, also set:
#   npx convex env set MOCKUSD_ADDRESS $MOCKUSD_ADDRESS
#   npx convex env set PACKCUSTODY_ADDRESS $PACKCUSTODY_ADDRESS
#   npx convex env set ASSETREGISTRY_ADDRESS $ASSETREGISTRY_ADDRESS
#   npx convex env set RIPENGINE_ADDRESS $RIPENGINE_ADDRESS
#   npx convex env set GAMETOKEN_ADDRESS $GAMETOKEN_ADDRESS
#   npx convex env set DISTRIBUTOR_ADDRESS $DISTRIBUTOR_ADDRESS
#   npx convex env set ROBINHOOD_TESTNET_RPC_URL $ROBINHOOD_TESTNET_RPC_URL
# Starter Grant minter (Convex-only). Must hold MockUSD MINTER_ROLE.
#   npx convex env set STARTER_GRANT_MINTER_PRIVATE_KEY 0x…
# Grant role once (deployer admin): cast send $MOCKUSD_ADDRESS \
#   "grantRole(bytes32,address)" $(cast keccak "MINTER_ROLE") $MINTER_ADDRESS
STARTER_GRANT_MINTER_PRIVATE_KEY=

# Manual smoke (#305) against Robinhood testnet:
#   1) Privy connect → Starter Grant lands (MockUSD balance $50)
#   2) Refill blocked within 24h; allowed after
#   3) Browse Pool shows indexed snapshot (zeros OK if no resting Packs)
#   4) After a Pack enters (pnpm testnet:e2e / House), stats + pack row update

# Legacy deal-game addresses (optional — rebuild pending)
# See docs/base-sepolia-configuration.md. Removed at #262.
NEXT_PUBLIC_ESCROW_ADDRESS=  # MarginCallEscrow (legacy address record)
ESCROW_ADDRESS=              # Same as NEXT_PUBLIC_ESCROW_ADDRESS — set in Convex env too
NEXT_PUBLIC_SEAT_VAULT_ADDRESS=  # SeatVault (legacy address record)
SEAT_VAULT_ADDRESS=              # Same as NEXT_PUBLIC_SEAT_VAULT_ADDRESS — set in Convex env too
ACTIVE_SEAT_VAULT_ADDRESS=       # Optional Convex override when rotating active vault version
NEXT_PUBLIC_MARGINCALL_TOKEN_ADDRESS=  # $BLOW / MARGINCALL ERC-20 (legacy address record)
MARGINCALL_TOKEN_ADDRESS=              # Same token address for Convex
NEXT_PUBLIC_MARGINCALL_TOKEN=    # Legacy alias — prefer NEXT_PUBLIC_MARGINCALL_TOKEN_ADDRESS
MARGINCALL_TOKEN=                # Legacy alias — prefer MARGINCALL_TOKEN_ADDRESS
IDENTITY_REGISTRY_ADDRESS=       # Optional Convex override — must match canonical registry
OPERATOR_PRIVATE_KEY=        # Legacy alias / fallback for DEPLOYER_PRIVATE_KEY

# Gate 3 (#211) — set to 1 after human approval to enable autonomous agent cycles.
# Convex: `npx convex env set AGENT_CYCLES_ENABLED 1`. Any other/missing value keeps
# the agent-scheduler idle (no enterDeal fan-out).
AGENT_CYCLES_ENABLED=
OPERATOR_SECRET=             # Shared secret for admin endpoints (e.g. resolve-pending)
# Comma-separated Privy subject IDs. Controls access to /admin/wire and gated Convex actions.
OPERATOR_SUBJECTS=           # (Convex env var — set in Convex dashboard or CLI, not .env.local)

# Upstash Redis (rate limiting) — optional for local dev (uses in-memory fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=           # For source map uploads
SENTRY_ORG=
SENTRY_PROJECT=
