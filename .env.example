# Convex
NEXT_PUBLIC_CONVEX_URL=       # From `npx convex dev` or Convex dashboard (e.g. https://xxx.convex.cloud)
CONVEX_DEPLOYMENT=            # Deployment name (e.g. dev:xxx) — set by `npx convex dev` in .env.local

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=    # Privy app ID; enable SMS login and Ethereum embedded wallets in the Privy dashboard
PRIVY_APP_SECRET=            # Server auth secret

# App
NEXT_PUBLIC_APP_URL=         # Base URL for app metadata (e.g. http://localhost:3000)

# RPC placeholders for the future Crash implementation
BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
# Minute-aligned Unix timestamp at least five minutes after deployment simulation
MARGIN_CALL_EPOCH_ORIGIN=
# Leave empty until deployed; the UI degrades to a "not configured" notice
NEXT_PUBLIC_DESK_DOLLARS_ADDRESS=
NEXT_PUBLIC_DESK_DOLLARS_FAUCET_ADDRESS=
NEXT_PUBLIC_BANKROLL_VAULT_ADDRESS=
NEXT_PUBLIC_MARGIN_CALL_CRASH_ADDRESS=
NEXT_PUBLIC_MARGIN_CALL_CRASH_DEPLOYMENT_BLOCK=

# Upstash Redis (rate limiting) — optional for local dev (uses in-memory fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=           # For source map uploads
SENTRY_ORG=
SENTRY_PROJECT=
