# Convex
NEXT_PUBLIC_CONVEX_URL=       # From `npx convex dev` or Convex dashboard (e.g. https://xxx.convex.cloud)
CONVEX_DEPLOYMENT=            # Deployment name (e.g. dev:xxx) — set by `npx convex dev` in .env.local

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=    # Privy app ID; enable SMS login and Ethereum embedded wallets in the Privy dashboard
PRIVY_APP_SECRET=            # Server auth secret

# App
NEXT_PUBLIC_APP_URL=         # Base URL for app metadata (e.g. http://localhost:3000)

# RPC placeholders for the future Crash implementation
BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
# Minute-aligned Unix timestamp at least five minutes after deployment simulation
MARGIN_CALL_EPOCH_ORIGIN=
# Leave empty until deployed; the UI degrades to a "not configured" notice
# Addresses must match contracts/deployments/base_sepolia.json (Base Sepolia only)
NEXT_PUBLIC_DESK_DOLLARS_ADDRESS=
NEXT_PUBLIC_DESK_DOLLARS_FAUCET_ADDRESS=
NEXT_PUBLIC_BANKROLL_VAULT_ADDRESS=
NEXT_PUBLIC_MARGIN_CALL_CRASH_ADDRESS=
NEXT_PUBLIC_MARGIN_CALL_CRASH_DEPLOYMENT_BLOCK=

# Crash keeper (Convex dashboard secrets — never commit values)
# KEEPER_PRIVATE_KEY=           # Funded EOA; pays gas + Inco round-creation fee
# KEEPER_PREOPEN_ENABLED=true   # Keep current+next epochs initialized during active sessions
# KEEPER_ATTESTATION_URL=       # App origin for POST /api/crash-attestation
# KEEPER_ALERT_WEBHOOK_URL=     # Optional alert webhook
# KEEPER_PAYMASTER_SPEND_BUDGET_WEI=  # Optional sponsorship spend budget (wei string)
# MARGIN_CALL_CRASH_ADDRESS=    # Optional override; defaults to curated Base Sepolia record
# BANKROLL_VAULT_ADDRESS=
# INCO_LIGHTNING_ADDRESS=
# See docs/runbooks/keeper.md and docs/runbooks/deploy-smoke-release.md

# Desk phone / liquidation voice (Convex dashboard secrets — never commit values)
# MARGIN_CALL_VOICE_ENABLED=true   # Kill switch; must be true to place Twilio calls
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=              # E.164 Twilio caller ID
# PRIVY_APP_SECRET=                # Also required on Convex to resolve login phone at call time
# (Convex already uses PRIVY_APP_ID for auth; set PRIVY_APP_SECRET there too for voice)

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=           # For source map uploads
SENTRY_ORG=
SENTRY_PROJECT=
