# Convex
NEXT_PUBLIC_CONVEX_URL=       # From `npx convex dev` or Convex dashboard (e.g. https://xxx.convex.cloud)
CONVEX_DEPLOYMENT=            # Deployment name (e.g. dev:xxx) — set by `npx convex dev` in .env.local

# Dynamic
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=  # From Dynamic console → Developer → API. Enable external EVM wallets + Base (8453); allowlist localhost:3000 and prod origin; use in-app token storage.

# App
NEXT_PUBLIC_APP_URL=         # Base URL for app metadata (e.g. http://localhost:3000)

# Base mainnet RPC (public reads; writes go through the connected wallet)
NEXT_PUBLIC_BASE_RPC_URL=    # Optional; defaults to https://mainnet.base.org

# RPC placeholders for future testnet work
BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=           # For source map uploads
SENTRY_ORG=
SENTRY_PROJECT=
